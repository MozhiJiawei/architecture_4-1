      ]
    },
    {
      "id": "path-model-express",
      "label": "ModelExpress 启动",
      "summary": "operator 向组件注入 MODEL_EXPRESS_URL，worker 以 mx-source/mx-target 接入 Model Express，从共享分发端而非各自冷下载权重。",
      "entrypoint": "docs/kubernetes/model-caching.md#option-2-model-express-p2p-distribution",
      "main_step_ids": [
        "r-mx-01",
