  "primary_paths": [
    {
      "id": "path-shared-cache",
      "label": "共享缓存启动",
      "summary": "先由一次性下载任务把模型写入共享 PVC，再由 frontend 与 worker 复用同一缓存完成元数据与权重装载，减少新副本的重复下载。",
      "entrypoint": "docs/kubernetes/model-caching.md#option-1-pvc--download-job-recommended",
      "main_step_ids": [
        "r-cache-01",
        "r-cache-02",
